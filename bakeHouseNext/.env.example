NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin credentials (hashed password stored in env)
ADMIN_PASSWORD_HASH=$2b$10$YourHashedPasswordHere
ADMIN_USERNAME=admin

# JWT secret for session tokens (generate a random 32+ char string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Google Maps API key (for Places Autocomplete on checkout page)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

