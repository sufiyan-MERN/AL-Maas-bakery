# Al Maas Bakery – Environment Variables Configuration

# 1. Supabase PostgreSQL Database (Optional - App includes full offline/local storage fallback)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Admin Authentication
# Default password if not set: AlMaas@Admin2026
VITE_ADMIN_PASSWORD=AlMaas@Admin2026

# 3. Google Maps Places Autocomplete API (Optional - App includes GPS & OpenStreetMap reverse geocoding fallback)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

